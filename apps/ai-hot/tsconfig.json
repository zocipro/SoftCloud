{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "./worker-configuration.d.ts",
      "node"
    ],
    "lib": [
      "ES2022"
    ]
  },
  "include": [
    "src/**/*",
    "upstream/*.ts",
    "worker-configuration.d.ts"
  ]
}
