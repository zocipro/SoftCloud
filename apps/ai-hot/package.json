{
  "name": "softcloud-ai-hot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790 --test-scheduled",
    "typecheck": "wrangler types --strict-vars=false && tsc --noEmit",
    "test": "node scripts/bundle-test.mjs && node --test tests/*.test.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.0.0",
    "@modelcontextprotocol/server": "2.1.0",
    "zod": "4.6.5",
    "@aihot/contracts": "workspace:*",
    "@aihot/industry": "workspace:*"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "typescript": "^5.9.0",
    "@cloudflare/workers-types": "latest",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.1"
  }
}
